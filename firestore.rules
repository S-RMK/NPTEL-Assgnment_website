rules_version = '2';

// No client — signed in or not — may read or write this database directly.
//
// The web app talks only to the Express API, which authenticates the caller, checks
// their role, and enforces course enrolment before returning anything. The server uses
// the Firebase Admin SDK, which bypasses these rules entirely, so closing every path
// here costs the app nothing and removes the possibility of reading course content by
// querying Firestore with the public web config embedded in the JS bundle.
//
// (The original ruleset was `allow read, write: if true` on `/{document=**}` — the whole
// database, including bcrypt password hashes, was world-readable and world-writable.)
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
